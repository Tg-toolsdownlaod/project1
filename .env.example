# ---- HTTP API ----
# Shared secret the frontend sends as the x-api-key header.
BACKEND_API_KEY=change-me
# Comma-separated origins allowed to call this service from a browser.
CORS_ORIGINS=http://localhost:5173,https://tg-tools-downlaod.vercel.app
PORT=8000

# ---- Supabase (service role, NEVER the anon key) ----
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Telegram userbot ----
# Preferred: keep these here instead of in the database.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# Filled in after the first login; paste it back here to survive restarts.
TELEGRAM_SESSION_STRING=

# ---- Cloudflare R2 ----
# Optional overrides; by default these are read from the r2_settings table.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_URL=
R2_REGION=auto

# ---- Worker ----
# Seconds between background passes (downloads, auto rules, auto-forward).
WORKER_INTERVAL=30
# How many downloads may run at once (overrides download_settings when set).
# There is no hardcoded ceiling in the code -- set this as high as your CPU,
# disk and network can take. Telegram's own per-account throttle (FLOOD_WAIT)
# is a separate, server-side thing this number cannot raise or lower.
MAX_CONCURRENT_DOWNLOADS=
# Where files are staged before the R2 upload. Windows example: D:\tg-downloads
DOWNLOAD_DIR=

# ---- Speed / rate-limit tuning ----
# teleproto already opens up to 8 parallel connections per download file and
# grows the transfer window on its own. Raise this only if you have a fast
# link and want to push past that default; it trades a slightly higher chance
# of a temporary FLOOD_WAIT for more throughput. Leave blank to use the
# library's default.
TELEGRAM_MAX_DOWNLOAD_SESSIONS=
# Milliseconds the forwarder waits between messages by choice, to stay well
# under Telegram's flood limits on bulk forwarding/mirroring. Any real
# FLOOD_WAIT Telegram returns is always honored in full regardless of this
# value -- lowering it just means fewer of those waits are needed in the
# first place. Default 1500.
FORWARD_PAUSE_MS=1500
# Seconds: teleproto itself sleeps out any FLOOD_WAIT at or under this
# threshold automatically, silently, for EVERY API call the client makes --
# scanning, entity lookups, joins, all of it, not just the download/forward
# calls floodRetry.js wraps. The library's own default is a conservative 60s;
# this raises it so more of the ordinary waits are absorbed without an error
# ever surfacing. Capped by the library itself at 24h. Default here: 300 (5m).
TELEGRAM_FLOOD_SLEEP_THRESHOLD=300
