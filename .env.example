# Supabase project (same project your Bolt app uses)
SUPABASE_URL=https://ptbqpmzdltjqafxmlvzp.supabase.co
# Use the SERVICE ROLE key here (Project Settings -> API -> service_role),
# NOT the anon key. This server needs it to read/write telegram_settings,
# r2_settings, groups, topics, episodes, downloads.
SUPABASE_SERVICE_KEY=paste-your-service-role-key-here

# Comma-separated list of origins allowed to call this server.
# Put your Bolt/published app URL(s) here, e.g. https://telegram-group-video-txgk.bolt.host
ALLOWED_ORIGINS=http://localhost:5173

# A shared secret the frontend must send back in the "x-api-key" header.
# Prevents random people from calling your server. Make up any long random string.
BACKEND_API_KEY=change-me-to-a-long-random-string

PORT=8787
